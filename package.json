{
  "name": "planchette-api",
  "version": "0.1.0",
  "description": "API du monolithe Planchette (Node/TypeScript + MongoDB) — sert les produits nutrition sportive issus d'Open Food Facts.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "import:off": "ts-node scripts/importOpenFoodFacts.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^8.5.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
